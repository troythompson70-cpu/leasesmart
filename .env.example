# LeaseSmart Supabase — local/dev reference only. Do NOT commit .env with real keys.
# NEVER add SUPABASE_SERVICE_ROLE_KEY to frontend or committed files.

# Microsoft Graph (server/process only — never Vite client / never commit real values)
# Copy this file to .env on the iMac. Do not paste values into chat.
GRAPH_TENANT_ID=YOUR_GRAPH_TENANT_ID
GRAPH_CLIENT_ID=YOUR_GRAPH_CLIENT_ID
GRAPH_CLIENT_SECRET=YOUR_GRAPH_CLIENT_SECRET
# Optional alternatives:
# GRAPH_ACCESS_TOKEN=
# GRAPH_REFRESH_TOKEN=
# Mailbox Graph GET uses the primary UPN, not the info@ alias:
# GRAPH_MAILBOX_UPN=tgates@tgttechnologies.com

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_ONLY
# Import scripts only (scripts/e1-live-import.mjs) — never commit real values
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
E1_IMPORT_USER_ID=YOUR_PLATFORM_USER_UUID
