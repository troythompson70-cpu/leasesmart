{
  "name": "tgt-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:intake": "node --experimental-strip-types scripts/intake-validation-check.mjs && node scripts/assert-no-live-intake-probes.mjs && node --experimental-strip-types scripts/verify-dashboard-feed-check.mjs",
    "test:intake-policy": "node scripts/assert-no-live-intake-probes.mjs",
    "test:feed-verify": "node --experimental-strip-types scripts/verify-dashboard-feed-check.mjs",
    "verify:dashboard-feed": "node --experimental-strip-types scripts/verify-dashboard-feed.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
